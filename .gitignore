# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.key
*.cert

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — NEVER commit these (contain real API keys, service role keys)
.env
.env.local
.env.development
.env.production
.env.staging
.env*.local
supabase/functions/.env.local
supabase/functions/.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# supabase local state
supabase/.temp/
supabase/.branches/
.supabase/

# python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
.venv/
venv/
env/

# synthea / test medical PDFs — synthetic but realistic patient data
# must not be in a public repo
synthea-test-data/
pipeline_pdfs/
*.pdf

# docker build artifacts
.dockerignore

# log files (may contain URLs, tokens, stack traces)
*.log
tunnel_output.log

# OS
Thumbs.db

.vercel
.env*
.references/
