# Supabase Config
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter (replaces OpenAI + Anthropic — one key for all models)
# Get your key at https://openrouter.ai
OPENROUTER_API_KEY=

# Legacy — only needed if you have direct API access
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# AWS Comprehend Medical (optional — can be replaced by LLM-based extraction)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# Graphiti Python Wrapper URL (local dev: docker compose up)
GRAPHITI_WRAPPER_URL=http://localhost:8000

# FalkorDB (local docker-compose — host/port, NOT bolt://)
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=

# Remote FalkorDB (production — override local defaults)
# FALKORDB_HOST=r-6jissuruar.instance-ql5fhbodg.hc-7up0crkyn.ap-south-1.aws.f2e0a955bb84.cloud
# FALKORDB_PORT=49277
# FALKORDB_PASSWORD=

# Resend Email (for briefing notifications)
RESEND_API_KEY=

# OpenRouter model selection (override defaults)
ENTITY_EXTRACT_MODEL=openrouter/free
EMBED_MODEL=gemini-embedding-001

# Pipeline test script (tools/ingest_and_run.py) — never hardcode these
TEST_PATIENT_ID=
TEST_CAREGIVER_ID=
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# Supabase project reference (found in Supabase dashboard > Project Settings)
SUPABASE_PROJECT_REF=

# ngrok static domain (for local tunnel testing)
NGROK_STATIC_DOMAIN=

# Render API key (for Render CLI / API access)
RENDER_API_KEY=
