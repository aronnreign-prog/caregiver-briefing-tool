# Supabase Config
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google AI (Gemini 2.0 Flash — PDF extraction + briefing generation)
# Get your key at https://aistudio.google.com
# Vercel AI SDK reads GOOGLE_GENERATIVE_AI_API_KEY automatically
GOOGLE_GENERATIVE_AI_API_KEY=

# Zep Cloud (clinical memory — bi-temporal graph storage)
# Get your key at https://cloud.getzep.com
ZEP_API_KEY=

# Supabase project reference (found in Supabase dashboard > Project Settings)
SUPABASE_PROJECT_REF=

# ngrok static domain (for local tunnel testing, optional)
NGROK_STATIC_DOMAIN=